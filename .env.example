# ===============================================================
# Agent AM - Autonomous AI YouTube Channel Manager (.env.example)
# چینل: The Bayan (اسلامی تاریخ اور تعلیمی یوٹیوب چینل)
# ٹائم زون: Asia/Karachi (پاکستان معیاری وقت)
# ===============================================================

# 1. بنیادی کنفیگریشن (Core Configuration)
AGENT_NAME="Agent AM"
CHANNEL_NAME="The Bayan"
CHANNEL_ID="" # آپ کے یوٹیوب چینل کی آئی ڈی (مثلاً: UCxxxxxxxx)
TIMEZONE="Asia/Karachi"

# 2. خودکار شیڈولنگ کی ترتیبات (Scheduling Settings)
# روزانہ پوسٹنگ کا وقت شام 6:00 بجے سے رات 9:00 بجے تک (Asia/Karachi)
POSTING_WINDOW_START="18:00"
POSTING_WINDOW_END="21:00"
# روزانہ تفصیلی آڈٹ کا وقت (صبح 9:00 بجے)
DAILY_AUDIT_TIME="09:00"
# پوسٹنگ ہورائزن (گھنٹوں میں - کم از کم 24 سے 48 گھنٹے آگے)
SCHEDULING_HORIZON_HOURS=48

# 3. ڈیٹا بیس کی ترتیب (Database Configuration)
# لوکل اور کلاؤڈ دونوں کے لیے موزوں SQLite (یا PostgreSQL: postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL="sqlite+aiosqlite:///./agent_am.db"

# 4. اے آئی ماڈل کی ترتیبات (AI Model Settings)
# سپورٹڈ پرووائیڈرز: "gemini" یا "openai"
AI_PROVIDER="gemini"
# گوگل جیمنائی کی چابی (Google Gemini API Key)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# اوپن اے آئی چابی (OpenAI / ChatGPT API Key)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# منتخب ماڈل کا نام (مثلاً: gemini-2.5-flash یا gpt-4o-mini)
AI_MODEL_NAME="gemini-2.5-flash"

# 5. یوٹیوب اے پی آئی کریڈینشلز (YouTube Integration)
# سرکاری YouTube Data API v3 کی آفیشل Key
YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_KEY"
# اختیاری OAuth کلائنٹ فائل کا راستہ (اگر تفصیلی پرائیویٹ اینالیٹکس درکار ہوں)
YOUTUBE_CLIENT_SECRET_FILE="./client_secret.json"
YOUTUBE_TOKEN_FILE="./token.json"

# 6. یوٹیوب کمیونٹی پوسٹ اشاعت کا طریقہ (Community Post Publishing Mode)
# آپشنز: "studio_automation" (Playwright براؤزر آٹومیشن), "manual_export" (مینوئل ایکپورٹ / منظوری), "api"
PUBLISH_MODE="studio_automation"
HEADLESS_BROWSER=true

# 7. رپورٹس اور نوٹیفیکیشنز (Reports & Notifications)
REPORTS_DIR="./reports"
# ٹیلیگرام یا ڈسکارڈ ویب ہک (اختیاری روزانہ الرٹس کے لیے)
ALERT_WEBHOOK_URL=""

# 8. ویب ڈیش بورڈ سرور (Web Dashboard Server)
HOST="0.0.0.0"
PORT=8000
DEBUG=false
SECRET_KEY="change-me-to-a-random-secure-secret-key"
